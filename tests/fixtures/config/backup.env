# CI fixture — used by docker-compose.test.yml, bind-mounted read-write to /config.
# Points at the compose "minio" service. Scheme is required: restic's S3 backend
# defaults to HTTPS for a scheme-less endpoint, but the compose MinIO service only
# speaks plain HTTP, so a bare "minio:9000" would fail the containerized restic
# smoke run with a TLS error.
AWS_REGION=us-east-1
S3_BUCKET=usb-ci
S3_ENDPOINT=http://minio:9000
APPDATA_SRC=/backup/appdata
LOG_LEVEL=DEBUG
