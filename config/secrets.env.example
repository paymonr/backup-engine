# backup-engine — SECRETS (copy to secrets.env, chmod 600, never commit).
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
RESTIC_PASSWORD=CHANGEME-long-random-passphrase

# Optional: Cost Explorer (true invoice + forecast on the Cost page). A SEPARATE,
# READ-ONLY credential (ce:GetCostAndUsage, ce:GetCostForecast) — never the runtime
# key above. Normally set from the Cost page's "Connect AWS billing" form, not here.
#COST_EXPLORER_ACCESS_KEY_ID=
#COST_EXPLORER_SECRET_ACCESS_KEY=
#COST_EXPLORER_SESSION_TOKEN=
