# backup-engine — main configuration (copy to backup.env and edit).
# Only non-secret values here. Secrets go in secrets.env.

TZ=UTC
LOG_LEVEL=INFO                 # DEBUG|INFO|WARN|ERROR

# --- Schedules (supercronic cron expressions) ---
APPDATA_SCHEDULE=0 3 * * *      # nightly 03:00 — ships only when a new plugin archive exists
MEDIA_SCHEDULE=0 4 * * 0        # weekly Sun 04:00 — delta after the one-time bulk ingest

# --- AWS destination ---
AWS_REGION=us-east-1
S3_BUCKET=changeme-backup-engine
#S3_ENDPOINT=                    # only for S3-compatible backends (B2/R2/MinIO); leave blank for AWS
#RESTIC_REPOSITORY=              # derived as s3:<endpoint-or-aws-host>/<bucket>/appdata when blank

# --- Storage classes (per pipeline) ---
APPDATA_STORAGE_CLASS=STANDARD          # keep STANDARD. GLACIER/DEEP_ARCHIVE are NOT usable here in
                                         # Phase 1: restic must read the repo's config/keys objects
                                         # every run, and a cold repo can't be read without a thaw
                                         # first — that orchestration ships in Phase 3.
MEDIA_STORAGE_CLASS=DEEP_ARCHIVE        # cheapest cold storage for large static media

# --- Appdata retention (restic forget) ---
KEEP_LAST=3
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- Media behavior ---
MEDIA_MIRROR=false              # false = additive (rclone copy); true = exact mirror (rclone sync)
RCLONE_TRANSFERS=8
#RCLONE_BWLIMIT=                 # e.g. 20M to cap upload bandwidth

# --- Paths (match your bind mounts) ---
APPDATA_SRC=/backup/appdata
MEDIA_ROOT=/backup/media        # parent of your shares (mount /mnt/user here, read-only)
# Which shares/subdirs to back up is managed in the GUI (Media shares) and stored
# as one rclone filter file per share under /config/media-shares/<share>.txt.

# --- Notifications / health ---
#APPRISE_URLS=                   # space-separated Apprise URLs (discord://..., tgram://..., ntfy://...)
NOTIFY_ON_SUCCESS=false         # failures always notify; set true to also notify on success
#HEALTHCHECK_URL=                # healthchecks.io-style ping URL

# --- GUI (Phase 2; ignored by the engine) ---
GUI_PORT=8099
#GUI_ENABLED=true               # set false to run scheduler-only (no web GUI)
