# backup-engine — main configuration (copy to backup.env and edit).
# Only non-secret, global values here. Secrets go in secrets.env.
#
# Per-job settings — schedule, storage class, retention (restic keep-policy),
# and archive mirror mode — are NOT here. They live in config/jobs.json, one
# entry per job, managed by the GUI's Jobs screen (create/edit wizard). See
# config/jobs.json.example for the schema.

TZ=UTC
LOG_LEVEL=INFO                 # DEBUG|INFO|WARN|ERROR

# --- Source ---
SOURCE_ROOT=/backup/media       # single read-only mount; jobs pick folders under it

# --- AWS destination ---
AWS_REGION=us-east-1
S3_BUCKET=changeme-backup-engine
#S3_ENDPOINT=                    # only for S3-compatible backends (B2/R2/MinIO); leave blank for AWS
#RESTIC_REPOSITORY=              # derived as s3:<endpoint-or-aws-host>/<bucket>/appdata when blank
                                 # (the one shared restic repo; versioned jobs are tag-scoped by job name)

# --- rclone behavior (archive jobs) ---
RCLONE_TRANSFERS=8
#RCLONE_BWLIMIT=                 # e.g. 20M to cap upload bandwidth

# --- Notifications / health ---
#APPRISE_URLS=                   # space-separated Apprise URLs (discord://..., tgram://..., ntfy://...)
NOTIFY_ON_SUCCESS=false         # failures always notify; set true to also notify on success
#HEALTHCHECK_URL=                # healthchecks.io-style ping URL

# --- Cost Explorer (optional; connected from the Cost page, not here) ---
#COST_EXPLORER_TAG=              # cost-allocation "key=value" tag scoping the CE invoice to
                                 # this bucket; leave blank to report account-wide S3 spend.
                                 # The read-only CE credential itself lives in secrets.env,
                                 # set on the Cost page — never the runtime AWS key.

# --- GUI ---
GUI_PORT=8099
#GUI_ENABLED=true               # set false to run scheduler-only (no web GUI)
