opentofu/.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Runtime state / caches / logs
cache/
*.log

# OS / editor cruft
.DS_Store
*.swp

# Internal working docs (specs/plans) — not part of the distributable tool
docs/
