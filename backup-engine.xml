<?xml version="1.0"?>
<Container version="2">
  <Name>backup-engine</Name>
  <Repository>ghcr.io/paymonr/backup-engine:latest</Repository>
  <Registry>https://github.com/paymonr/backup-engine</Registry>
  <Network>bridge</Network>
  <Support>https://github.com/paymonr/backup-engine/issues</Support>
  <Project>https://github.com/paymonr/backup-engine</Project>
  <Overview>Off-site, encrypted AWS S3 backups for Unraid: appdata via restic, curated media via rclone (Glacier Deep Archive). The off-site leg of a 3-2-1 strategy.

Before starting this container, provision an AWS destination (bucket + least-privilege IAM user) with the included OpenTofu module or the scripted `setup.sh` — see the README — then populate backup.env / secrets.env / includes-media.txt under the Config path below.</Overview>
  <Category>Backup:</Category>
  <WebUI>http://[IP]:[PORT:8099]/</WebUI>
  <Config Name="Appdata backups (ro)" Target="/backup/appdata" Default="/mnt/appdata_system/appdata_backups" Mode="ro" Type="Path" Display="always" Required="true">Appdata Backup plugin output directory.</Config>
  <Config Name="Media root (ro)" Target="/backup/media" Default="/mnt/user/media" Mode="ro" Type="Path" Display="always" Required="true">Media root; curate which subdirs via includes-media.txt.</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/backup-engine/config" Mode="rw" Type="Path" Display="always" Required="true">backup.env, secrets.env, includes-media.txt.</Config>
  <Config Name="Cache/state" Target="/cache" Default="/mnt/user/appdata/backup-engine/cache" Mode="rw" Type="Path" Display="always" Required="true">restic cache, logs, run-state, lockfiles.</Config>
  <Config Name="GUI port" Target="8099" Default="8099" Mode="tcp" Type="Port" Display="always" Required="false">Web GUI (Phase 2).</Config>
</Container>
